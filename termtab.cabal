cabal-version:      3.4
-- The cabal-version field refers to the version of the .cabal specification,
-- and can be different from the cabal-install (the tool) version and the
-- Cabal (the library) version you are using. As such, the Cabal (the library)
-- version used must be equal or greater than the version stated in this field.
-- Starting from the specification version 2.2, the cabal-version field must be
-- the first thing in the cabal file.

-- Initial package description 'termtab' generated by
-- 'cabal init'. For further documentation, see:
--   http://haskell.org/cabal/users-guide/
--
-- The name of the package.
name:               termtab

-- The package version.
-- See the Haskell package versioning policy (PVP) for standards
-- guiding when and how versions should be incremented.
-- https://pvp.haskell.org
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            0.1.0.0

-- A short (one-line) description of the package.
synopsis:           TUI guitar tablature and score editor

-- A longer description of the package.
-- description:

-- The license under which the package is released.
license:            GPL-3.0-or-later

-- The file containing the license text.
license-file:       LICENSE

-- The package author(s).
author:             eureka-cpu

-- An email address to which users can send suggestions, bug reports, and patches.
maintainer:         github.eureka@gmail.com

-- A copyright notice.
-- copyright:
category:           Music
build-type:         Simple

-- Extra doc files to be distributed with the package, such as a CHANGELOG or a README.
extra-doc-files:    CHANGELOG.md

-- Extra source files to be distributed with the package, such as examples, or a tutorial module.
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:             warnings
    hs-source-dirs:     src
    exposed-modules:
        Termtab.Types
        Termtab.Defaults
        Termtab.Display
        Termtab.Parser.Common
        Termtab.Parser.MIDI
        Termtab.Parser.GP5
        Termtab.Parser.GP5.Internal
        Termtab.Audio
        Termtab.Audio.Types
        Termtab.Audio.FluidSynth
        Termtab.Audio.FluidSynth.Raw
        Termtab.Audio.Playback
        Termtab.Audio.PlaybackThread
        Termtab.Audio.PortMidi
        Termtab.Export.MIDI
        Termtab.UI
        Termtab.UI.Editing
        Termtab.UI.Types
        Termtab.UI.Keybindings
        Termtab.UI.Widgets.Tablature
        Termtab.UI.Widgets.Notation
        Termtab.UI.Widgets.StatusBar
        Termtab.UI.Widgets.TrackPanel
        Termtab.Graphics.Detect
        Termtab.Graphics.Kitty
        Termtab.Graphics.FreeType
        Termtab.Graphics.Health
    build-depends:
        base             ^>=4.20.2.0
      , text             ^>=2.1
      , containers       ^>=0.7
      , filepath         ^>=1.5
      , HCodecs          ^>=0.5.2
      , binary           ^>=0.8
      , bytestring       ^>=0.12
      , stm              ^>=2.5
      , brick            ^>=2.9
      , vty              ^>=6.4
      , vty-crossplatform ^>=0.4
      , microlens        ^>=0.4
      , JuicyPixels      ^>=3.3
      , vector           ^>=0.13
      , base64-bytestring ^>=1.2
    pkgconfig-depends:
        fluidsynth >=2.0, freetype2 >=2.0
    default-language:   GHC2021
    default-extensions: OverloadedStrings

executable termtab
    import:           warnings
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -threaded
    autogen-modules:  Paths_termtab
    other-modules:    Paths_termtab
    build-depends:
        base                 ^>=4.20.2.0
      , containers           ^>=0.7
      , optparse-applicative ^>=0.18.0.0
      , termtab
    default-language:   GHC2021
    default-extensions: OverloadedStrings

test-suite termtab-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    other-modules:
        Termtab.TypesSpec
        Termtab.Parser.MIDISpec
        Termtab.Parser.GP5Spec
        Termtab.Audio.PlaybackSpec
        Termtab.UI.EditingSpec
        Termtab.UI.TypesSpec
        Termtab.Graphics.DetectSpec
        Termtab.Graphics.KittySpec
        Termtab.Graphics.FreeTypeSpec
    build-depends:
        base        ^>=4.20.2.0
      , binary      ^>=0.8
      , brick       ^>=2.9
      , bytestring  ^>=0.12
      , containers  ^>=0.7
      , directory   ^>=1.3
      , tasty       ^>=1.5
      , tasty-hunit ^>=0.10
      , JuicyPixels ^>=3.3
      , vector      ^>=0.13
      , termtab
    default-language:   GHC2021
    default-extensions: OverloadedStrings
